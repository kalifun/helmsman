{
  "name": "helmsman-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Helmsman TS 产品服务：spawn dsh 引擎 + ACP 控制 + JSONL 观察 + HTTP/WS API",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
